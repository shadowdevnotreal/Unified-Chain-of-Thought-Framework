def get_user_choice() -> int:
    """Get user's menu selection"""
    while True:
        try:
            choice = input(f"{Colors.YELLOW}Select option (1-9): {Colors.END}")
            choice_num = int(choice)
            if 1 <= choice_num <= 9:
                return choice_num
            else:
                print(f"{Colors.RED}{Icons.CROSS} Please enter a number between 1 and 9{Colors.END}")
        except ValueError:
            print(f"{Colors.RED}{Icons.CROSS} Please enter a valid number{Colors.END}")
        except KeyboardInterrupt:
            print(f"\n{Colors.YELLOW}Exiting...{Colors.END}")
            sys.exit(0)


