def analyze_requirements(description: str, category: str) -> Dict:
    """Analyze task requirements"""
    print(f"\n{Colors.BLUE}{Icons.ROBOT} Analyzing requirements...{Colors.END}")

    # Detect complexity
    complexity_indicators = {
        "critical": ["critical", "production", "emergency", "security"],
        "high": ["refactor", "migrate", "architecture", "system"],
        "medium": ["feature", "implement", "optimize"],
        "low": ["fix", "small", "simple", "quick"]
    }

    detected_complexity = "medium"
    desc_lower = description.lower()

    for complexity, keywords in complexity_indicators.items():
        if any(k in desc_lower for k in keywords):
            detected_complexity = complexity
            break

    # Detect security critical
    security_keywords = ["auth", "security", "password", "token", "credential", "vulnerability"]
    security_critical = any(k in desc_lower for k in security_keywords)

    return {
        "complexity": detected_complexity,
        "security_critical": security_critical,
        "category": category,
        "word_count": len(description.split())
    }


def display_recommendation(result):
    """Display agent recommendation"""
    print(f"\n{Colors.GREEN}{Icons.CHECK} Analysis complete!{Colors.END}\n")

    # Display metadata
    print(f"{Colors.BOLD}Task Analysis:{Colors.END}")
    print(f"  {Icons.CHART} Complexity: {Colors.YELLOW}{result.complexity.value.upper()}{Colors.END}")
    print(f"  {Icons.LIGHTNING} Security Critical: {Colors.YELLOW}{'Yes' if result.metadata['analysis']['security_critical'] else 'No'}{Colors.END}")
    print(f"  ⏱️  Estimated Time: {Colors.YELLOW}{result.estimated_total_time}{Colors.END}")
    print(f"  {Icons.STAR} Success Probability: {Colors.GREEN}{result.success_probability * 100:.1f}%{Colors.END}")

    if result.similar_past_tasks > 0:
        print(f"  📁 Similar Tasks: {Colors.CYAN}{result.similar_past_tasks} in history{Colors.END}")

    # Display recommended chain
    print(f"\n{Colors.BOLD}{Icons.ROBOT} Recommended Agent Workflow:{Colors.END}\n")

    for rec in result.recommended_chain:
        # Color intensity based on level
        intensity_color = (Colors.RED if rec.intensity.value == "cot++" else
                         Colors.PURPLE if rec.intensity.value == "cot+" else
                         Colors.BLUE)

        print(f"  {Colors.BOLD}{rec.priority}.{Colors.END} {rec.agent_name}")
        print(f"     {Icons.LIGHTNING} Intensity: {intensity_color}{rec.intensity.value}{Colors.END}")
        print(f"     {Icons.BRAIN} Reason: {Colors.CYAN}{rec.reason}{Colors.END}")
        print(f"     {Icons.CHART} Confidence: {Colors.GREEN}{rec.confidence * 100:.1f}%{Colors.END}")
        print(f"     ⏱️  Duration: {Colors.YELLOW}{rec.estimated_duration}{Colors.END}")
        print()


def confirm_proceed() -> bool:
    """Ask user to confirm proceeding"""
    while True:
        try:
            response = input(f"{Colors.YELLOW}Proceed with this workflow? [Y/n]: {Colors.END}").strip().lower()
            if response in ['', 'y', 'yes']:
                return True
            elif response in ['n', 'no']:
                return False
            else:
                print(f"{Colors.RED}Please enter 'y' or 'n'{Colors.END}")
        except KeyboardInterrupt:
            print()
            return False


def execute_workflow(result):
    """Execute the recommended workflow"""
    print(f"\n{Colors.GREEN}{Icons.ROCKET} Starting workflow...{Colors.END}\n")

    total_agents = len(result.recommended_chain)

    for idx, rec in enumerate(result.recommended_chain, 1):
        print(f"{Colors.BOLD}[{idx}/{total_agents}] Executing: {rec.agent_name}{Colors.END}")
        print(f"Intensity: {rec.intensity.value}")

        # Simulate execution (in real implementation, this would call actual agents)
        print(f"{Colors.BLUE}⏳ Processing...{Colors.END}")

        # Mock progress
        import time
        for i in range(5):
            print(".", end="", flush=True)
            time.sleep(0.2)

        print(f" {Colors.GREEN}{Icons.CHECK} Complete{Colors.END}\n")

    print(f"{Colors.GREEN}{Colors.BOLD}{Icons.STAR} Workflow completed successfully!{Colors.END}\n")


